# Same completed private file for the whole authorized team. chmod 600 .env.infra.
ACCESS_MODE=shared_admin
NEON_API_KEY=replace-with-organization-admin-key
RENDER_API_KEY=replace-with-full-account-key
BETTERSTACK_API_KEY=replace-with-global-read-write-key
PGHOST=ep-morning-grass-barfhgst.c-8.eu-central-1.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=replace-with-shared-main-database-password
DEV_BRANCH=dev-team
DEV_DB_URL='jdbc:postgresql://replace-with-team-dev-host.neon.tech:5432/neondb?sslmode=require&channelBinding=require'
DEV_DB_USERNAME=neondb_owner
DEV_DB_PASSWORD=replace-with-distinct-development-password
